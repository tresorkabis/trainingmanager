# ---------------------------------------------------------------------------
# Variables d'environnement pour le déploiement de production (Vercel + Supabase)
# Copier ce fichier vers .env et/ou remplir les variables dans le tableau de
# bord Vercel (Settings > Environment Variables).
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=False
# Générer une clé forte : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hôtes autorisés (séparés par des virgules) + origines CSRF
ALLOWED_HOSTS=trainingmanager-seven.vercel.app,www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://trainingmanager-seven.vercel.app,https://www.votre-domaine.com

# Supabase PostgreSQL
# IMPORTANT : utiliser la chaîne de connexion "Transaction mode pooler"
# (port 6543) : Settings > Database > Connection string > Transaction
# Exemple : postgresql://postgres.cwlhkqmmzawtvwutdpdc:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage (fichiers médias uploadés)
# Récupérables dans Supabase > Project Settings > Storage > S3 Access Keys
SUPABASE_PROJECT_REF=cwlhkqmmzawtvwutdpdc
# Endpoint S3 (hôte direct *.storage.supabase.co = performances optimales)
SUPABASE_S3_ENDPOINT=https://cwlhkqmmzawtvwutdpdc.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Région du projet (à vérifier dans le dashboard), ex. us-east-1, eu-central-1
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_BUCKET=media