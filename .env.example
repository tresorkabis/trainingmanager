# Copier en .env et remplacer les valeurs avant le premier démarrage.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Hôtes autorisés et origines HTTPS, séparés par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL dans Compose
POSTGRES_DB=trainingmanager
POSTGRES_USER=trainingmanager
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Port publié sur l'hôte
APP_PORT=8000

# pgAdmin (démarrer avec : docker compose --profile admin up -d)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=5050

# Optionnel : stockage objet compatible S3 pour médias persistants et partagés.
# Si les deux clés restent vides, les médias utilisent le volume Docker media_data.
SUPABASE_PROJECT_REF=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_BUCKET=media
